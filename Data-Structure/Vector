#include <iostream>
#include <string>

using namespace std;

class Vector{
private:
	int size = 0;
	int capacity = 0;
	int* arr = nullptr;

public:
	Vector(int sz = 0, int cp = 0) : size(sz), capacity(cp) {
	    arr = (capacity > 0) ? new int[capacity] : nullptr;
	}

	~Vector(){ delete[] arr; }

	void expand_capacity(){
		if (capacity == 0) {
		    capacity = 1;
		} else {
		    capacity *= 2;
		}

		int* new_arr = new int[capacity];

		for(int i=0; i<size; ++i){
			new_arr[i] = arr[i];
		}

		delete[] arr;

		arr = new_arr;
	}

	void push_back(int value) {
	    if(capacity <= size){
	    	expand_capacity();
	    }

	    arr[size] = value;
	    size++;
	}

	void right_rotate(){
		int first= arr[size-1];
		int *temp = &arr[size-2];

		for(int i=size-1; i > 0; --i){
			arr[i] = *temp;
			temp--;
		}

		arr[0] = first;
	}

	void left_rotate(){
		int first= arr[0];

		for(int i=0; i < size-1; ++i){
			arr[i] = arr[i+1];
		}

		arr[size-1] = first;
	}

	void right_rotate(int stepNumber){
		// Bad approach
/*		while(stepNumber--){
			right_rotate();
		}*/

		// Good Approach
		int turns = stepNumber % size;

		while(turns--){
			right_rotate();
		}
	}

	int pop(int idx){
		int value = arr[idx];

		int* new_arr = new int(size-1);

		int j = -1;
		for(int i=0; i<size; i++){
			if(i != idx) {
				j++;
				new_arr[j] = arr[i];
			}
		}

		delete[] arr;
		arr = new_arr;
		size--;

		return value;
	}

	int find_transposition(int value){
		for(int i=0 ; i<size; ++i){
			if(arr[i] == value){
				if(i != 0){
					int temp = arr[i];
					arr[i] = arr[i-1];
					arr[i-1] = temp;
				}
				return i-1;
			}
		}
		return -1;
	}

	void display(){
		for(int i=0; i<size; ++i){
			cout << arr[i] << " ";
		}
	}

};



int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    Vector v1;
    v1.push_back(10);
    v1.push_back(20);
    v1.push_back(30);
    v1.push_back(40);
    v1.push_back(50);
    v1.find_transposition(30);

    v1.display();

    return 0;
}
